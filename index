  <script>
    // Nav scroll effect
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 60);
    });

    // Reveal on scroll
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    // Form submit (send to WhatsApp or just show confirmation)
    function handleForm(e) {
      e.preventDefault();
      const name    = document.getElementById('name').value;
      const phone   = document.getElementById('phone').value;
      const service = document.getElementById('service').value;
      const date    = document.getElementById('date').value;
      const msg     = document.getElementById('msg').value;

      const packages = {
        base: 'Momentto Base — R$ 347',
        plus: 'Momentto Plus — R$ 447',
        story: 'Momentto Story — R$ 347',
        vip: 'Momentto VIP — R$ 647',
        '': 'Não informado'
      };

      const text = encodeURIComponent(
        `Olá, Momentto Rio! Me chamo *${name}*.\n` +
        `Tenho interesse no pacote *${packages[service]}*.\n` +
        (date ? `Data desejada: ${new Date(date + 'T12:00:00').toLocaleDateString('pt-BR')}.\n` : '') +
        (phone ? `Meu contato: ${phone}.\n` : '') +
        (msg ? `\n${msg}` : '')
      );

      // Replace 55XXXXXXXXXXX with the actual WhatsApp number
      window.open(`https://wa.me/55?text=${text}`, '_blank');
    }
  </script>

