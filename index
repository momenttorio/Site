  <!-- CONTACT -->
  <section id="contato">
    <div class="contact">
      <div class="contact-left">
        <p class="section-label reveal">Fale conosco</p>
        <h2 class="section-title reveal reveal-delay-1">Vamos criar algo<br><em style="font-style:italic; color:var(--tan);">inesquecível</em></h2>
